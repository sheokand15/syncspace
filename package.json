{
  "name": "syncspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web", "apps/server"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace apps/server run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "start": "node apps/server/dist/index.js",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "benchmark:sync": "node tests/benchmarks/sync-latency.mjs",
    "db:migrate": "npm --workspace apps/server run migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
